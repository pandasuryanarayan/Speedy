# ---------------------------------------------------------------------------
# Speedy configuration. Copy to .env and edit. Never commit .env.
# ---------------------------------------------------------------------------

# development | production
NODE_ENV=development

PORT=3000
# Public URL of the app. Used for CORS/CSRF origin checks and cookie security.
PUBLIC_ORIGIN=http://localhost:3000

# Where the SQLite file, uploads and dev secrets live.
DATA_DIR=./data
UPLOAD_DIR=./data/uploads

# --- Secrets (REQUIRED in production) --------------------------------------
# openssl rand -base64 48
JWT_SECRET=
# openssl rand -base64 32   (must decode to exactly 32 bytes - AES-256 key)
MESSAGE_KEY=

# --- Sessions ---------------------------------------------------------------
# Access token lifetime (seconds) and refresh token lifetime (seconds).
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000
# A session dies after this much inactivity...
SESSION_IDLE_MINUTES=30
# ...and after this long in total, however often it is refreshed.
SESSION_ABSOLUTE_DAYS=30

# --- Proxies / limits -------------------------------------------------------
# Set to 1 when running behind one reverse proxy (nginx, Caddy, Cloudflare).
TRUST_PROXY=0
MAX_UPLOAD_BYTES=10485760
LOG_LEVEL=info
