# =============================================================================
# Speedy configuration. Copy to .env (`npm run setup` does this for you).
# Only NODE_ENV, PUBLIC_ORIGIN, JWT_SECRET and MESSAGE_KEY are required.
# =============================================================================

NODE_ENV=production
PORT=3000
PUBLIC_ORIGIN=http://localhost:3000

DATA_DIR=./data
UPLOAD_DIR=./data/uploads

# --- Secrets (generate: openssl rand -base64 48 / 32) ------------------------
JWT_SECRET=
MESSAGE_KEY=

# --- Sessions ---------------------------------------------------------------
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_DAYS=30

# --- Auth policy (self-hosters can shape the app here) ----------------------
# Close public signups once your team is onboarded.
ALLOW_REGISTRATION=true
# Require a confirmed email before the first sign-in (needs SMTP below).
REQUIRE_EMAIL_VERIFICATION=false
# off | optional | required
MFA_POLICY=optional
# Comma separated usernames promoted to admin at boot (moderation console).
ADMIN_USERNAMES=

# --- Email (optional: password reset + verification) ------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Speedy <no-reply@example.com>

# --- Hardening (optional) ---------------------------------------------------
# Breached-password screening via Have I Been Pwned (k-anonymity).
HIBP_ENABLED=true
# ClamAV scanning for uploads (clamd INSTREAM).
CLAMAV_HOST=
CLAMAV_PORT=3310
# Slack-compatible webhook for security alerts.
ALERT_WEBHOOK_URL=

# --- Scaling (optional) -----------------------------------------------------
# Set to share socket rooms across several app instances.
REDIS_URL=

# --- Web push (optional) ----------------------------------------------------
# Generate with: npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# --- Proxies / limits -------------------------------------------------------
TRUST_PROXY=0
MAX_UPLOAD_BYTES=10485760
LOG_LEVEL=info
