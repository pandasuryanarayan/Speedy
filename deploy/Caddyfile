# Caddy terminates TLS automatically (Let's Encrypt) and proxies to the app.
{$PUBLIC_ORIGIN} {
	encode zstd gzip

	# Attachments can be up to MAX_UPLOAD_BYTES.
	request_body {
		max_size 12MB
	}

	@socket path /socket.io/*
	handle @socket {
		reverse_proxy speedy:3000
	}

	handle {
		reverse_proxy speedy:3000
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}
}
